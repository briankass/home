int ScaleDpi(int val) {
    return MulDiv(val, g_currentDpi, 96);
}

COLORREF HexToColorRef(PCWSTR hex) {
    if (!hex || wcslen(hex) < 6) return RGB(255, 255, 255);
    int r = 0, g = 0, b = 0;
    swscanf_s(hex, L"%02x%02x%02x", &r, &g, &b);
    return RGB(r, g, b);
}

const wchar_t* GetWeatherInfo(int code, int isDay, WCHAR* outText, size_t textLen) {
    const wchar_t* icon = isDay ? L"☀️" : L"🌙";
    const wchar_t* text = isDay ? L"Sunny" : L"Clear";

    switch (code) {
        case 0:  icon = isDay ? L"☀️" : L"🌙"; text = isDay ? L"Clear Sky" : L"Clear"; break;
        case 1:
        case 2:  icon = isDay ? L"🌤️" : L"☁️"; text = L"Partly Cloudy"; break;
        case 3:  icon = L"☁️"; text = L"Overcast"; break;
        case 45:
        case 48: icon = L"🌫️"; text = L"Fog"; break;
        case 51:
        case 53:
        case 55: icon = L"🌧️"; text = L"Drizzle"; break;
        case 61:
        case 63:
        case 65: icon = L"🌧️"; text = L"Rain"; break;
        case 71:
        case 73:
        case 75:
        case 77: icon = L"❄️"; text = L"Snow"; break;
        case 80:
        case 81:
        case 82: icon = isDay ? L"🌦️" : L"🌧️"; text = L"Rain Showers"; break;
        case 95:
        case 96:
        case 99: icon = L"⛈️"; text = L"Thunderstorm"; break;
    }

    if (outText && textLen > 0) StringCchCopyW(outText, textLen, text);
    return icon;
}

const wchar_t* DegreesToCompass(int deg) {
    const wchar_t* dirs[] = { L"N", L"NE", L"E", L"SE", L"S", L"SW", L"W", L"NW", L"N" };
    return dirs[(int)((deg + 22.5f) / 45.0f) % 8];
}

void CleanGDI() {
    if (g_hFont)         { DeleteObject(g_hFont); g_hFont = NULL; }
    if (g_hFontHeroTemp) { DeleteObject(g_hFontHeroTemp); g_hFontHeroTemp = NULL; }
    if (g_hFontTitle)    { DeleteObject(g_hFontTitle); g_hFontTitle = NULL; }
    if (g_hFontNormal)   { DeleteObject(g_hFontNormal); g_hFontNormal = NULL; }
    if (g_hFontBold)     { DeleteObject(g_hFontBold); g_hFontBold = NULL; }
    if (g_hFontSmall)    { DeleteObject(g_hFontSmall); g_hFontSmall = NULL; }
    if (g_hBrushBg)      { DeleteObject(g_hBrushBg); g_hBrushBg = NULL; }
    if (g_hBrushPill)    { DeleteObject(g_hBrushPill); g_hBrushPill = NULL; }
    if (g_hBrushTrack)   { DeleteObject(g_hBrushTrack); g_hBrushTrack = NULL; }
    if (g_hBrushFill)    { DeleteObject(g_hBrushFill); g_hBrushFill = NULL; }
    if (g_hPenRim)       { DeleteObject(g_hPenRim); g_hPenRim = NULL; }
}

void LoadSettings() {
    g_settings.fontSize = Wh_GetIntSetting(L"font_size");
    if (g_settings.fontSize <= 0) g_settings.fontSize = 13;

    PCWSTR hexColor = Wh_GetStringSetting(L"text_color");
    g_settings.textColor = HexToColorRef(hexColor);
    if (hexColor) Wh_FreeStringSetting(hexColor);

    g_settings.yOffset = Wh_GetIntSetting(L"y_offset");
    if (g_settings.yOffset == 0) g_settings.yOffset = 11;

    g_settings.xOffset = Wh_GetIntSetting(L"x_offset");
    if (g_settings.xOffset <= 0) g_settings.xOffset = 700;

    PCWSTR latStr = Wh_GetStringSetting(L"latitude");
    if (latStr && wcslen(latStr) > 0) StringCchCopyW(g_settings.latitude, ARRAYSIZE(g_settings.latitude), latStr);
    else StringCchCopyW(g_settings.latitude, ARRAYSIZE(g_settings.latitude), L"34.3000");
    if (latStr) Wh_FreeStringSetting(latStr);

    PCWSTR lonStr = Wh_GetStringSetting(L"longitude");
    if (lonStr && wcslen(lonStr) > 0) StringCchCopyW(g_settings.longitude, ARRAYSIZE(g_settings.longitude), lonStr);
    else StringCchCopyW(g_settings.longitude, ARRAYSIZE(g_settings.longitude), L"-77.8700");
    if (lonStr) Wh_FreeStringSetting(lonStr);

    PCWSTR locStr = Wh_GetStringSetting(L"location_name");
    if (locStr && wcslen(locStr) > 0) StringCchCopyW(g_settings.locationName, ARRAYSIZE(g_settings.locationName), locStr);
    else StringCchCopyW(g_settings.locationName, ARRAYSIZE(g_settings.locationName), L"Murrayville, NC");
    if (locStr) Wh_FreeStringSetting(locStr);

    HDC hdc = GetDC(NULL);
    g_currentDpi = hdc ? GetDeviceCaps(hdc, LOGPIXELSY) : 96;
    if (hdc) ReleaseDC(NULL, hdc);

    CleanGDI();

    int barH = -MulDiv(g_settings.fontSize, g_currentDpi, 72);
    g_hFont = CreateFontW(barH, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");

    int heroH = -MulDiv(38, g_currentDpi, 72);
    g_hFontHeroTemp = CreateFontW(heroH, 0, 0, 0, FW_LIGHT, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");

    int titleH = -MulDiv(15, g_currentDpi, 72);
    g_hFontTitle = CreateFontW(titleH, 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");

    int normH = -MulDiv(10, g_currentDpi, 72);
    g_hFontNormal = CreateFontW(normH, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");

    g_hFontBold = CreateFontW(normH, 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");

    int smallH = -MulDiv(8, g_currentDpi, 72);
    g_hFontSmall = CreateFontW(smallH, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");

    g_hBrushBg = CreateSolidBrush(RGB(15, 16, 19));
