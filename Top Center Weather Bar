        SelectObject(memDC, oldBmp);
        DeleteObject(memBmp);
        DeleteDC(memDC);

        EndPaint(hWnd, &ps);
        return 0;
    }
    case WM_ERASEBKGND:
        return 1;

    case WM_DESTROY:
        return 0;
    }
    return DefWindowProcW(hWnd, uMsg, wParam, lParam);
}

LRESULT CALLBACK WeatherWndProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {
    switch (uMsg) {
    case WM_DISPLAYCHANGE:
        LoadSettings();
        RepositionWeather(hWnd);
        return 0;

    case WM_LBUTTONUP:
        if (IsWindowVisible(g_hWndFlyout)) {
            AnimateWindow(g_hWndFlyout, 120, AW_BLEND | AW_HIDE);
        } else {
            RepositionAndShowFlyout();
        }
        return 0;

    case WM_RBUTTONUP: {
        HANDLE hTh = CreateThread(NULL, 0, FetchWeatherThread, (LPVOID)FALSE, 0, NULL);
        if (hTh) CloseHandle(hTh);
        return 0;
    }

    case WM_SETCURSOR:
        SetCursor(LoadCursor(NULL, IDC_HAND));
        return TRUE;

    case WM_TIMER:
        if (wParam == 1001) {
            // Periodic 1-second top-most assert loop to ensure Explorer doesn't cover the bar
            static int s_settleCount = 0;
            if (s_settleCount < 3) {
                s_settleCount++;
                RepositionWeather(hWnd);
            }

            BOOL isFullscreen = IsMonitorInFullscreen(hWnd);
            BOOL isVisible = IsWindowVisible(hWnd);

            if (isFullscreen && isVisible) {
                ShowWindow(hWnd, SW_HIDE);
                if (IsWindowVisible(g_hWndFlyout)) ShowWindow(g_hWndFlyout, SW_HIDE);
            } else if (!isFullscreen) {
                if (!isVisible) {
                    ShowWindow(hWnd, SW_SHOWNOACTIVATE);
                }
                SetWindowPos(hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
            }

            if (g_hWndFlyout && IsWindowVisible(g_hWndFlyout)) {
                InvalidateRect(g_hWndFlyout, NULL, FALSE);
            }
        } else if (wParam == 1002) {
            // Background weather refresh (15 minutes)
            HANDLE hTh = CreateThread(NULL, 0, FetchWeatherThread, (LPVOID)FALSE, 0, NULL);
            if (hTh) CloseHandle(hTh);
        }
        return 0;

    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hWnd, &ps);

        RECT rc;
        GetClientRect(hWnd, &rc);

        HDC memDC = CreateCompatibleDC(hdc);
        HBITMAP memBmp = CreateCompatibleBitmap(hdc, rc.right, rc.bottom);
        HGDIOBJ oldBmp = SelectObject(memDC, memBmp);

        HBRUSH blackBrush = CreateSolidBrush(RGB(0, 0, 0));
        FillRect(memDC, &rc, blackBrush);
        DeleteObject(blackBrush);

        SetBkMode(memDC, TRANSPARENT);
        SetTextColor(memDC, g_settings.textColor);

        HGDIOBJ oldFont = SelectObject(memDC, g_hFont);

        EnterCriticalSection(&g_weatherLock);
        if (g_weatherStr[0] != L'\0') {
            DrawTextW(memDC, g_weatherStr, -1, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
        }
        LeaveCriticalSection(&g_weatherLock);

        SelectObject(memDC, oldFont);
        BitBlt(hdc, 0, 0, rc.right, rc.bottom, memDC, 0, 0, SRCCOPY);

        SelectObject(memDC, oldBmp);
        DeleteObject(memBmp);
        DeleteDC(memDC);

        EndPaint(hWnd, &ps);
        return 0;
    }

    case WM_ERASEBKGND:
        return 1;

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProcW(hWnd, uMsg, wParam, lParam);
}

DWORD WINAPI WeatherWindowThread(LPVOID) {
    LoadSettings();

    WNDCLASSEXW wc = { sizeof(wc) };
    wc.lpfnWndProc = WeatherWndProc;
    wc.hInstance = GetModuleHandle(NULL);
    wc.lpszClassName = L"WindhawkTopCenterWeatherBar";
    RegisterClassExW(&wc);

    WNDCLASSEXW wcf = { sizeof(wcf) };
    wcf.lpfnWndProc = FlyoutWndProc;
    wcf.hInstance = wc.hInstance;
    wcf.lpszClassName = L"WindhawkWeatherFlyout";
    RegisterClassExW(&wcf);

    g_hWndWeather = CreateWindowExW(
        WS_EX_LAYERED | WS_EX_TOPMOST | WS_EX_NOACTIVATE,
        wc.lpszClassName, L"", 
        WS_POPUP,
        0, 0, ScaleDpi(110), ScaleDpi(20),
        NULL, NULL, wc.hInstance, NULL
    );

    g_hWndFlyout = CreateWindowExW(
        WS_EX_TOPMOST | WS_EX_TOOLWINDOW,
        wcf.lpszClassName, L"",
        WS_POPUP,
        0, 0, ScaleDpi(590), ScaleDpi(295),
        NULL, NULL, wc.hInstance, NULL
    );

    if (g_hWndWeather) {
        SetLayeredWindowAttributes(g_hWndWeather, RGB(0, 0, 0), 0, LWA_COLORKEY);
        RepositionWeather(g_hWndWeather);

        // Timer 1001: 1000ms persistent top-most check & clock tick
        SetTimer(g_hWndWeather, 1001, 1000, NULL);
        // Timer 1002: 15-minute fetch cycle
        SetTimer(g_hWndWeather, 1002, 900000, NULL);

        HANDLE hTh = CreateThread(NULL, 0, FetchWeatherThread, (LPVOID)TRUE, 0, NULL);
        if (hTh) CloseHandle(hTh);

        MSG msg;
        while (GetMessageW(&msg, NULL, 0, 0)) {
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
    }
    return 0;
}

BOOL Wh_ModInit() {
    InitializeCriticalSection(&g_weatherLock);
    g_bRunning = TRUE;
    g_hWeatherThread = CreateThread(NULL, 0, WeatherWindowThread, NULL, 0, &g_weatherThreadId);
    return TRUE;
}

void Wh_ModUninit() {
    g_bRunning = FALSE;
    if (g_hWndFlyout) {
        DestroyWindow(g_hWndFlyout);
        g_hWndFlyout = NULL;
    }
    if (g_hWndWeather) {
        KillTimer(g_hWndWeather, 1001);
        KillTimer(g_hWndWeather, 1002);
        DestroyWindow(g_hWndWeather);
        g_hWndWeather = NULL;
    }

    if (g_weatherThreadId) {
        PostThreadMessageW(g_weatherThreadId, WM_QUIT, 0, 0);
    }

    if (g_hWeatherThread) {
        WaitForSingleObject(g_hWeatherThread, 1000);
        CloseHandle(g_hWeatherThread);
        g_hWeatherThread = NULL;
    }

    CleanGDI();
    DeleteCriticalSection(&g_weatherLock);
}

void Wh_ModSettingsChanged() {
    if (g_hWndWeather) {
        HDC hdc = GetDC(NULL);
        g_currentDpi = hdc ? GetDeviceCaps(hdc, LOGPIXELSY) : 96;
        if (hdc) ReleaseDC(NULL, hdc);

        g_settings.yOffset = Wh_GetIntSetting(L"y_offset");
        if (g_settings.yOffset == 0) g_settings.yOffset = 11;

        g_settings.xOffset = Wh_GetIntSetting(L"x_offset");
        if (g_settings.xOffset <= 0) g_settings.xOffset = 700;

        RepositionWeather(g_hWndWeather);
        InvalidateRect(g_hWndWeather, NULL, TRUE);
    }
}
