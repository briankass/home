                SetTextColor(memDC, RGB(130, 135, 145));
                DrawTextW(memDC, minStr, -1, &rcMinLbl, DT_RIGHT | DT_VCENTER | DT_SINGLELINE);

                int barTrackLeft = dailyLeft + ScaleDpi(78);
                int barTrackRight = rc.right - padX - ScaleDpi(26);
                int trackWidth = barTrackRight - barTrackLeft;

                RECT rcTrack = { barTrackLeft, dRowY + ScaleDpi(6), barTrackRight, dRowY + ScaleDpi(10) };
                FillRect(memDC, &rcTrack, g_hBrushTrack);

                int fillL = barTrackLeft + ((w.daily[i].minTemp - w.weekMinTemp) * trackWidth) / weekSpread;
                int fillR = barTrackLeft + ((w.daily[i].maxTemp - w.weekMinTemp) * trackWidth) / weekSpread;
                if (fillR - fillL < ScaleDpi(8)) fillR = fillL + ScaleDpi(8);

                RECT rcFill = { fillL, dRowY + ScaleDpi(6), fillR, dRowY + ScaleDpi(10) };
                FillRect(memDC, &rcFill, g_hBrushFill);

                RECT rcMaxLbl = { barTrackRight + ScaleDpi(4), dRowY, rc.right - padX, dRowY + dRowH };
