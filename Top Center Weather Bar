                StringCchPrintfW(maxStr, ARRAYSIZE(maxStr), L"%d°", w.daily[i].maxTemp);
                SelectObject(memDC, g_hFontBold);
                SetTextColor(memDC, RGB(255, 255, 255));
                DrawTextW(memDC, maxStr, -1, &rcMaxLbl, DT_LEFT | DT_VCENTER | DT_SINGLELINE);

                dRowY += dRowH;
            }

            RECT rcFooter = { padX, rc.bottom - ScaleDpi(20), rc.right - padX, rc.bottom - ScaleDpi(6) };
            SelectObject(memDC, g_hFontSmall);
            SetTextColor(memDC, RGB(100, 105, 115));
            DrawTextW(memDC, w.lastUpdated, -1, &rcFooter, DT_LEFT | DT_SINGLELINE);
        }

