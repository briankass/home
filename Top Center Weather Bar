            AnimateWindow(hWnd, 120, AW_BLEND | AW_HIDE);
        }
        return 0;

    case WM_LBUTTONUP: {
        int x = LOWORD(lParam);
        int y = HIWORD(lParam);
        RECT rcLoc = { ScaleDpi(20), ScaleDpi(16), ScaleDpi(240), ScaleDpi(44) };
        if (PtInRect(&rcLoc, (POINT){ x, y })) {
            OpenWeatherWeb();
        }
        return 0;
