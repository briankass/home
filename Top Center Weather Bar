// ==WindhawkModReadme==
/*
Top Center Weather Bar - Visibility Restored Edition
- Persistent HWND_TOPMOST maintenance loop to prevent Explorer covering the bar
- Instant visual placeholder (--°F) to avoid transparent blank window during initial sync
- Fixed hardcoded offsets (Y = 11, X = 700)
- Fully decoupled GDI lifecycle to eliminate toolkit crashes
*/
// ==/WindhawkModReadme==

// ==WindhawkModSettings==
/*
- font_size: 13
  $name: Font Size
- text_color: "FFFFFF"
  $name: Text Color (HEX)
- y_offset: 11
  $name: Vertical Offset (Y)
- x_offset: 700
  $name: Distance From Right Screen Edge (X)
- latitude: "34.3000"
  $name: Latitude (Decimal degrees, e.g. 34.3000)
- longitude: "-77.8700"
  $name: Longitude (Decimal degrees, e.g. -77.8700)
- location_name: "Murrayville, NC"
  $name: Display Location Name
*/
// ==/WindhawkModSettings==

