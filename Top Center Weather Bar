BOOL IsMonitorInFullscreen(HWND hTargetWnd) {
    HMONITOR hMon = MonitorFromWindow(hTargetWnd, MONITOR_DEFAULTTONEAREST);
    if (!hMon) return FALSE;

    MONITORINFO mi = { sizeof(mi) };
    if (!GetMonitorInfoW(hMon, &mi)) return FALSE;

    HWND hFg = GetForegroundWindow();
    if (!hFg || hFg == hTargetWnd || hFg == g_hWndFlyout) return FALSE;

    WCHAR className[64] = {0};
    GetClassNameW(hFg, className, ARRAYSIZE(className));
    if (wcscmp(className, L"Progman") == 0 ||
        wcscmp(className, L"WorkerW") == 0 ||
        wcscmp(className, L"Shell_TrayWnd") == 0 ||
        wcscmp(className, L"Shell_SecondaryTrayWnd") == 0) {
        return FALSE;
    }

    RECT rcFg;
    if (GetWindowRect(hFg, &rcFg)) {
        if (rcFg.left <= mi.rcMonitor.left &&
            rcFg.top <= mi.rcMonitor.top &&
            rcFg.right >= mi.rcMonitor.right &&
            rcFg.bottom >= mi.rcMonitor.bottom) {
            return TRUE;
        }
    }
    return FALSE;
}

void ParseForecastJson(const char* json) {
    if (!json || strstr(json, "\"error\":true")) return;

    WeatherData temp = {0};
    StringCchCopyW(temp.location, ARRAYSIZE(temp.location), g_settings.locationName);

    const char* current = strstr(json, "\"current\":");
    int curCode = 0;
    if (current) {
        float t = 0.0f, at = 0.0f, ws = 0.0f, uv = 0.0f;
        int hum = 0, isDayVal = 1, wd = 0;
        const char* p;
        if ((p = strstr(current, "\"temperature_2m\":"))) sscanf_s(p + 17, "%f", &t);
        if ((p = strstr(current, "\"apparent_temperature\":"))) sscanf_s(p + 23, "%f", &at);
        if ((p = strstr(current, "\"relative_humidity_2m\":"))) sscanf_s(p + 24, "%d", &hum);
        if ((p = strstr(current, "\"weather_code\":"))) sscanf_s(p + 15, "%d", &curCode);
        if ((p = strstr(current, "\"wind_speed_10m\":"))) sscanf_s(p + 17, "%f", &ws);
        if ((p = strstr(current, "\"wind_direction_10m\":"))) sscanf_s(p + 21, "%d", &wd);
        if ((p = strstr(current, "\"uv_index\":"))) sscanf_s(p + 11, "%f", &uv);
        if ((p = strstr(current, "\"is_day\":"))) sscanf_s(p + 9, "%d", &isDayVal);

        temp.currentTemp = (int)(t >= 0 ? t + 0.5f : t - 0.5f);
        temp.apparentTemp = (int)(at >= 0 ? at + 0.5f : at - 0.5f);
        temp.humidity = hum;
        temp.windSpeed = ws;
        temp.uvIndex = uv;
        temp.isDay = isDayVal;
        temp.weatherCode = curCode;
        StringCchCopyW(temp.windDir, ARRAYSIZE(temp.windDir), DegreesToCompass(wd));

        const wchar_t* ico = GetWeatherInfo(curCode, temp.isDay, temp.conditionText, ARRAYSIZE(temp.conditionText));
        StringCchCopyW(temp.currentIcon, ARRAYSIZE(temp.currentIcon), ico);
    }

    const char* daily = strstr(json, "\"daily\":");
    if (daily) {
        const char* pTime = strstr(daily, "\"time\":[");
        const char* pCode = strstr(daily, "\"weather_code\":[");
        const char* pMax = strstr(daily, "\"temperature_2m_max\":[");
        const char* pMin = strstr(daily, "\"temperature_2m_min\":[");
        const char* pPop = strstr(daily, "\"precipitation_probability_max\":[");
        const char* pRise = strstr(daily, "\"sunrise\":[");
        const char* pSet = strstr(daily, "\"sunset\":[");

        if (pRise) {
            int rH = 0, rM = 0;
            const char* tQ = strstr(pRise, "T");
            if (tQ && sscanf_s(tQ + 1, "%d:%d", &rH, &rM) == 2) {
                int rH12 = rH % 12; if (rH12 == 0) rH12 = 12;
                StringCchPrintfW(temp.sunriseTime, ARRAYSIZE(temp.sunriseTime), L"%d:%02d AM", rH12, rM);
            }
        }
        if (pSet) {
            int sH = 0, sM = 0;
            const char* tQ = strstr(pSet, "T");
            if (tQ && sscanf_s(tQ + 1, "%d:%d", &sH, &sM) == 2) {
                int sH12 = sH % 12; if (sH12 == 0) sH12 = 12;
                StringCchPrintfW(temp.sunsetTime, ARRAYSIZE(temp.sunsetTime), L"%d:%02d PM", sH12, sM);
            }
        }

        if (pTime && pCode && pMax && pMin) {
            pTime += 8; pCode += 16; pMax += 22; pMin += 22;
            if (pPop) pPop += 33;

            const wchar_t* days[] = { L"Sun", L"Mon", L"Tue", L"Wed", L"Thu", L"Fri", L"Sat" };
            temp.weekMinTemp = 999;
            temp.weekMaxTemp = -999;

            for (int i = 0; i < 5; i++) {
                int y = 0, m = 0, d = 0;
                if (pTime && sscanf_s(pTime, "\"%d-%d-%d\"", &y, &m, &d) == 3) {
                    SYSTEMTIME st = {0};
                    st.wYear = (WORD)y; st.wMonth = (WORD)m; st.wDay = (WORD)d;
                    FILETIME ft;
                    SystemTimeToFileTime(&st, &ft);
                    FileTimeToSystemTime(&ft, &st);
                    StringCchCopyW(temp.daily[i].day, 16, days[st.wDayOfWeek % 7]);
                    pTime = strstr(pTime, ","); if (pTime) pTime++;
                }

                int dCode = 0;
                if (pCode) {
                    sscanf_s(pCode, "%d", &dCode);
                    StringCchCopyW(temp.daily[i].icon, 8, GetWeatherInfo(dCode, 1, NULL, 0));
                    pCode = strchr(pCode, ','); if (pCode) pCode++;
                }

                float mx = 0.0f, mn = 0.0f;
                if (pMax) { sscanf_s(pMax, "%f", &mx); pMax = strchr(pMax, ','); if (pMax) pMax++; }
                if (pMin) { sscanf_s(pMin, "%f", &mn); pMin = strchr(pMin, ','); if (pMin) pMin++; }
                
                temp.daily[i].maxTemp = (int)(mx >= 0 ? mx + 0.5f : mx - 0.5f);
                temp.daily[i].minTemp = (int)(mn >= 0 ? mn + 0.5f : mn - 0.5f);

                if (temp.daily[i].minTemp < temp.weekMinTemp) temp.weekMinTemp = temp.daily[i].minTemp;
                if (temp.daily[i].maxTemp > temp.weekMaxTemp) temp.weekMaxTemp = temp.daily[i].maxTemp;

                if (i == 0) {
                    temp.highTemp = temp.daily[0].maxTemp;
                    temp.lowTemp = temp.daily[0].minTemp;
                    if (pPop) {
                        int popVal = 0;
                        sscanf_s(pPop, "%d", &popVal);
                        temp.precipProb = popVal;
                    }
                }
                if (pPop) { pPop = strchr(pPop, ','); if (pPop) pPop++; }
            }
        }
    }

    const char* hourly = strstr(json, "\"hourly\":");
    if (hourly) {
        const char* pTime = strstr(hourly, "\"time\":[");
        const char* pTemp = strstr(hourly, "\"temperature_2m\":[");
        const char* pCode = strstr(hourly, "\"weather_code\":[");
        const char* pIsDay = strstr(hourly, "\"is_day\":[");

        if (pTime && pTemp && pCode && pIsDay) {
            pTime += 8; pTemp += 18; pCode += 16; pIsDay += 10;

            SYSTEMTIME stNow;
            GetLocalTime(&stNow);
            int currentHour = stNow.wHour;

            while (*pTime && *pTime != ']') {
                int h = 0;
                const char* tQuote = strstr(pTime, "T");
                if (tQuote) {
                    sscanf_s(tQuote + 1, "%d", &h);
                    if (h >= currentHour || (currentHour == 23 && h == 0)) break;
                }

                const char* nextT = strchr(pTime, ',');
                const char* nextTmp = strchr(pTemp, ',');
                const char* nextCd = strchr(pCode, ',');
                const char* nextDay = strchr(pIsDay, ',');

                if (!nextT || !nextTmp || !nextCd || !nextDay) break;

                pTime = nextT + 1;
                pTemp = nextTmp + 1;
                pCode = nextCd + 1;
                pIsDay = nextDay + 1;
            }

            for (int i = 0; i < 5 && *pTime && *pTime != ']'; i++) {
                int hour = 0;
                const char* tQuote = strstr(pTime, "T");
                if (tQuote) {
                    sscanf_s(tQuote + 1, "%d", &hour);
                    if (hour == 0) StringCchCopyW(temp.hourly[i].time, 16, L"12 AM");
                    else if (hour < 12) StringCchPrintfW(temp.hourly[i].time, 16, L"%d AM", hour);
                    else if (hour == 12) StringCchCopyW(temp.hourly[i].time, 16, L"12 PM");
                    else StringCchPrintfW(temp.hourly[i].time, 16, L"%d PM", hour - 12);
                    pTime = strstr(tQuote, ","); if (pTime) pTime++;
                }

                float hTemp = 0.0f;
                sscanf_s(pTemp, "%f", &hTemp);
                temp.hourly[i].temp = (int)(hTemp >= 0 ? hTemp + 0.5f : hTemp - 0.5f);
                pTemp = strchr(pTemp, ','); if (pTemp) pTemp++;

                int hCode = 0, hIsDay = 1;
                sscanf_s(pCode, "%d", &hCode);
                sscanf_s(pIsDay, "%d", &hIsDay);
                StringCchCopyW(temp.hourly[i].icon, 8, GetWeatherInfo(hCode, hIsDay, NULL, 0));
                pCode = strchr(pCode, ','); if (pCode) pCode++;
                pIsDay = strchr(pIsDay, ','); if (pIsDay) pIsDay++;
            }
        }
    }

    SYSTEMTIME stSync;
    GetLocalTime(&stSync);
    int h12 = stSync.wHour % 12;
    if (h12 == 0) h12 = 12;
    StringCchPrintfW(temp.lastUpdated, ARRAYSIZE(temp.lastUpdated), L"Updated %d:%02d %s",
        h12, stSync.wMinute, (stSync.wHour >= 12) ? L"PM" : L"AM");

    temp.valid = TRUE;

    EnterCriticalSection(&g_weatherLock);
    g_weather = temp;
    StringCchPrintfW(g_weatherStr, ARRAYSIZE(g_weatherStr), L"%s %d°F", g_weather.currentIcon, g_weather.currentTemp);
    LeaveCriticalSection(&g_weatherLock);
}

BOOL ExecuteWeatherFetch() {
    HINTERNET hInternet = InternetOpenW(L"Mozilla/5.0", INTERNET_OPEN_TYPE_PRECONFIG, NULL, NULL, 0);
    if (!hInternet) return FALSE;

    DWORD timeoutMs = 4000;
    InternetSetOptionW(hInternet, INTERNET_OPTION_CONNECT_TIMEOUT, &timeoutMs, sizeof(timeoutMs));
    InternetSetOptionW(hInternet, INTERNET_OPTION_RECEIVE_TIMEOUT, &timeoutMs, sizeof(timeoutMs));

    WCHAR url[1024];
    StringCchPrintfW(
        url, ARRAYSIZE(url),
        L"https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s"
        L"&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m,wind_direction_10m,uv_index,is_day"
        L"&hourly=temperature_2m,weather_code,is_day"
        L"&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset"
        L"&temperature_unit=fahrenheit&wind_speed_unit=mph&forecast_days=6&timezone=auto",
        g_settings.latitude, g_settings.longitude
    );

    HINTERNET hUrl = InternetOpenUrlW(hInternet, url, NULL, 0, INTERNET_FLAG_RELOAD | INTERNET_FLAG_NO_CACHE_WRITE, 0);
    BOOL success = FALSE;

    if (hUrl) {
        char* buffer = (char*)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, 65536);
        if (buffer) {
            DWORD bytesRead = 0, totalBytes = 0;
            while (InternetReadFile(hUrl, buffer + totalBytes, 65535 - totalBytes, &bytesRead) && bytesRead > 0) {
                totalBytes += bytesRead;
                if (totalBytes >= 65534) break;
            }
            buffer[totalBytes] = '\0';
            ParseForecastJson(buffer);
            HeapFree(GetProcessHeap(), 0, buffer);
            success = TRUE;

            if (g_hWndWeather && g_bRunning) InvalidateRect(g_hWndWeather, NULL, TRUE);
            if (g_hWndFlyout && IsWindowVisible(g_hWndFlyout)) InvalidateRect(g_hWndFlyout, NULL, TRUE);
        }
        InternetCloseHandle(hUrl);
    }
    InternetCloseHandle(hInternet);
    return success;
}

DWORD WINAPI FetchWeatherThread(LPVOID lpParam) {
    BOOL isBoot = (BOOL)(INT_PTR)lpParam;
    if (isBoot) {
        for (int i = 0; i < 24 && g_bRunning; i++) {
            if (ExecuteWeatherFetch()) break;
            for (int s = 0; s < 50 && g_bRunning; s++) Sleep(100);
        }
    } else {
        ExecuteWeatherFetch();
    }
    return 0;
}

void RepositionWeather(HWND hWnd) {
    HMONITOR hMon = MonitorFromWindow(hWnd, MONITOR_DEFAULTTOPRIMARY);
    MONITORINFO mi = { sizeof(mi) };
    if (!GetMonitorInfoW(hMon, &mi)) return;

    int winWidth = ScaleDpi(110);
    int winHeight = ScaleDpi(20);
    
    int x = mi.rcMonitor.right - winWidth - g_settings.xOffset;
    int y = mi.rcMonitor.top + g_settings.yOffset;

    SetWindowRgn(hWnd, NULL, TRUE);
    SetWindowPos(hWnd, HWND_TOPMOST, x, y, winWidth, winHeight, SWP_NOACTIVATE | SWP_SHOWWINDOW);
}

void RepositionAndShowFlyout() {
    if (!g_hWndWeather || !g_hWndFlyout) return;

    RECT rcWeather;
    GetWindowRect(g_hWndWeather, &rcWeather);

    int width = ScaleDpi(590);
    int height = ScaleDpi(295);
    int x = (rcWeather.left + rcWeather.right) / 2 - (width / 2);
    int y = rcWeather.bottom + ScaleDpi(8);

    HRGN hRgn = CreateRoundRectRgn(0, 0, width + 1, height + 1, ScaleDpi(20), ScaleDpi(20));
    SetWindowRgn(g_hWndFlyout, hRgn, TRUE);

    SetWindowPos(g_hWndFlyout, HWND_TOPMOST, x, y, width, height, SWP_HIDEWINDOW);
    AnimateWindow(g_hWndFlyout, 140, AW_BLEND | AW_SLIDE | AW_VER_POSITIVE | AW_ACTIVATE);
    SetForegroundWindow(g_hWndFlyout);
}

void OpenWeatherWeb() {
    WCHAR url[256];
    StringCchPrintfW(url, ARRAYSIZE(url), L"https://open-meteo.com/en/docs?latitude=%s&longitude=%s",
        g_settings.latitude, g_settings.longitude);
    ShellExecuteW(NULL, L"open", url, NULL, NULL, SW_SHOWNORMAL);
}

