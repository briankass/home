            int dRowY = bottomY + ScaleDpi(20);
            int dRowH = ScaleDpi(18);
            int weekSpread = (w.weekMaxTemp - w.weekMinTemp);
            if (weekSpread <= 0) weekSpread = 1;

            for (int i = 0; i < 4; i++) {
                RECT rcDDay   = { dailyLeft, dRowY, dailyLeft + ScaleDpi(28), dRowY + dRowH };
                RECT rcDIcon  = { dailyLeft + ScaleDpi(30), dRowY, dailyLeft + ScaleDpi(50), dRowY + dRowH };
                RECT rcMinLbl = { dailyLeft + ScaleDpi(52), dRowY, dailyLeft + ScaleDpi(74), dRowY + dRowH };

