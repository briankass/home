// ==WindhawkMod==
// @id              top-bar-power-menu
// @name            Top Bar Power Menu
// @description     Minimalist top-bar power button anchored next to the Start button with a quick OLED flyout to Lock, Sleep, Restart, or Shut Down.
// @version         1.1.0
// @author          Custom
// @include         explorer.exe
// @compilerOptions -lgdi32 -luser32 -ldwmapi -luxtheme -lshell32 -lpowrprof
// ==/WindhawkMod==

// ==WindhawkModReadme==
/*
Top Bar Power Menu
Features:
- Transparent floating power icon anchored to the left of the bar next to Start
- Minimalist OLED black flyout dashboard
- Instant execution: Lock, Sleep, Restart, and Shut Down
- Raw 1:1 pixel offsets to prevent DPI misalignment across reboots
*/
// ==/WindhawkModReadme==

// ==WindhawkModSettings==
/*
- font_size: 13
  $name: Font Size
- text_color: "FFFFFF"
  $name: Text Color (HEX)
- y_offset: 9
  $name: Vertical Offset (Y)
- x_offset: 70
  $name: Distance From Left Screen Edge (X)
*/
// ==/WindhawkModSettings==

#include <windows.h>
#include <windhawk_api.h>
#include <strsafe.h>
#include <dwmapi.h>
#include <powrprof.h>
#include <stdio.h>

struct {
    int fontSize;
    COLORREF textColor;
    int yOffset;
    int xOffset;
} g_settings;

HWND g_hWndBtn = NULL;
HWND g_hWndFlyout = NULL;
HANDLE g_hThread = NULL;
DWORD g_threadId = 0;
UINT_PTR g_timerZOrder = 0;

HFONT g_hFontBar = NULL;
HFONT g_hFontTitle = NULL;
HFONT g_hFontBtn = NULL;

volatile BOOL g_bRunning = TRUE;
int g_currentDpi = 96;
int g_hoveredAction = -1; // 0: Lock, 1: Sleep, 2: Restart, 3: Shutdown

int ScaleDpi(int val) {
    return MulDiv(val, g_currentDpi, 96);
}

COLORREF HexToColorRef(PCWSTR hex) {
    if (!hex || wcslen(hex) < 6) return RGB(255, 255, 255);
    int r = 0, g = 0, b = 0;
    swscanf_s(hex, L"%02x%02x%02x", &r, &g, &b);
    return RGB(r, g, b);
}

void LoadSettings() {
    g_settings.fontSize = Wh_GetIntSetting(L"font_size");
    if (g_settings.fontSize <= 0) g_settings.fontSize = 13;

    PCWSTR hexColor = Wh_GetStringSetting(L"text_color");
    g_settings.textColor = HexToColorRef(hexColor);
    Wh_FreeStringSetting(hexColor);

    g_settings.yOffset = Wh_GetIntSetting(L"y_offset");
    if (g_settings.yOffset == 0) g_settings.yOffset = 9;

    g_settings.xOffset = Wh_GetIntSetting(L"x_offset");
    if (g_settings.xOffset <= 0) g_settings.xOffset = 70; // Default to 44px from left

    HDC hdc = GetDC(NULL);
    g_currentDpi = GetDeviceCaps(hdc, LOGPIXELSY);
    ReleaseDC(NULL, hdc);

    if (g_hFontBar)   { DeleteObject(g_hFontBar); g_hFontBar = NULL; }
    if (g_hFontTitle) { DeleteObject(g_hFontTitle); g_hFontTitle = NULL; }
    if (g_hFontBtn)   { DeleteObject(g_hFontBtn); g_hFontBtn = NULL; }

    int barH = -MulDiv(g_settings.fontSize, g_currentDpi, 72);
    g_hFontBar = CreateFontW(barH, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");

    int titleH = -MulDiv(11, g_currentDpi, 72);
    g_hFontTitle = CreateFontW(titleH, 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");

    int btnH = -MulDiv(10, g_currentDpi, 72);
    g_hFontBtn = CreateFontW(btnH, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Variable Display");
}

void RepositionBarButton(HWND hWnd) {
    HMONITOR hMon = MonitorFromWindow(hWnd, MONITOR_DEFAULTTOPRIMARY);
    MONITORINFO mi = { sizeof(mi) };
    if (!GetMonitorInfoW(hMon, &mi)) return;

    int winWidth = ScaleDpi(28);
    int winHeight = ScaleDpi(24);

    // Anchor directly from the LEFT edge of your display
    int x = mi.rcMonitor.left + g_settings.xOffset;
    int y = mi.rcMonitor.top + g_settings.yOffset;

    SetWindowRgn(hWnd, NULL, TRUE);
    SetWindowPos(hWnd, HWND_TOPMOST, x, y, winWidth, winHeight, SWP_NOACTIVATE | SWP_SHOWWINDOW);
}

void RepositionAndShowFlyout() {
    if (!g_hWndBtn || !g_hWndFlyout) return;

    RECT rcBtn;
    GetWindowRect(g_hWndBtn, &rcBtn);

    int width = ScaleDpi(190);
    int height = ScaleDpi(184);

    // Align flyout starting from the button's left edge
    int x = rcBtn.left;
    int y = rcBtn.bottom + ScaleDpi(8);

    HRGN hRgn = CreateRoundRectRgn(0, 0, width + 1, height + 1, ScaleDpi(16), ScaleDpi(16));
    SetWindowRgn(g_hWndFlyout, hRgn, TRUE);

    SetWindowPos(g_hWndFlyout, HWND_TOPMOST, x, y, width, height, SWP_HIDEWINDOW);
    AnimateWindow(g_hWndFlyout, 120, AW_BLEND | AW_SLIDE | AW_VER_POSITIVE | AW_ACTIVATE);
    SetForegroundWindow(g_hWndFlyout);
}

void ExecutePowerAction(int actionIndex) {
    ShowWindow(g_hWndFlyout, SW_HIDE);
    switch (actionIndex) {
        case 0: // Lock
            LockWorkStation();
            break;
        case 1: // Sleep
            SetSuspendState(FALSE, TRUE, FALSE);
            break;
        case 2: // Restart
            ExitWindowsEx(EWX_REBOOT | EWX_FORCEIFHUNG, SHTDN_REASON_MAJOR_OPERATINGSYSTEM | SHTDN_REASON_FLAG_PLANNED);
            break;
        case 3: // Shut Down
            ExitWindowsEx(EWX_SHUTDOWN | EWX_FORCEIFHUNG, SHTDN_REASON_MAJOR_OPERATINGSYSTEM | SHTDN_REASON_FLAG_PLANNED);
            break;
    }
}

LRESULT CALLBACK FlyoutWndProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {
    switch (uMsg) {
    case WM_ACTIVATE:
        if (LOWORD(wParam) == WA_INACTIVE) {
            AnimateWindow(hWnd, 100, AW_BLEND | AW_HIDE);
        }
        return 0;

    case WM_MOUSEMOVE: {
        int y = HIWORD(lParam);
        int padY = ScaleDpi(36);
        int itemH = ScaleDpi(34);

        int prev = g_hoveredAction;
        if (y >= padY && y < padY + (itemH * 4)) {
            g_hoveredAction = (y - padY) / itemH;
        } else {
            g_hoveredAction = -1;
        }

        if (prev != g_hoveredAction) {
            InvalidateRect(hWnd, NULL, FALSE);
        }

        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hWnd, 0 };
        TrackMouseEvent(&tme);
        return 0;
    }

    case WM_MOUSELEAVE:
        if (g_hoveredAction != -1) {
            g_hoveredAction = -1;
            InvalidateRect(hWnd, NULL, FALSE);
        }
        return 0;

    case WM_LBUTTONUP: {
        if (g_hoveredAction >= 0 && g_hoveredAction < 4) {
            ExecutePowerAction(g_hoveredAction);
        }
        return 0;
    }

    case WM_SETCURSOR:
        if (g_hoveredAction != -1) {
            SetCursor(LoadCursor(NULL, IDC_HAND));
            return TRUE;
        }
        break;

    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hWnd, &ps);

        RECT rc;
        GetClientRect(hWnd, &rc);

        HDC memDC = CreateCompatibleDC(hdc);
        HBITMAP memBmp = CreateCompatibleBitmap(hdc, rc.right, rc.bottom);
        HGDIOBJ oldBmp = SelectObject(memDC, memBmp);

        // Pure OLED Black background
        HBRUSH bgBrush = CreateSolidBrush(RGB(15, 16, 19));
        FillRect(memDC, &rc, bgBrush);
        DeleteObject(bgBrush);

        // Slate rim
        HPEN rimPen = CreatePen(PS_SOLID, 1, RGB(42, 45, 52));
        HGDIOBJ oldPen = SelectObject(memDC, rimPen);
        SelectObject(memDC, GetStockObject(NULL_BRUSH));
        RoundRect(memDC, 0, 0, rc.right, rc.bottom, ScaleDpi(16), ScaleDpi(16));
        SelectObject(memDC, oldPen);
        DeleteObject(rimPen);

        SetBkMode(memDC, TRANSPARENT);

        // Header Title
        SelectObject(memDC, g_hFontTitle);
        SetTextColor(memDC, RGB(140, 145, 155));
        RECT rcTitle = { ScaleDpi(14), ScaleDpi(10), rc.right - ScaleDpi(14), ScaleDpi(30) };
        DrawTextW(memDC, L"Power Options", -1, &rcTitle, DT_LEFT | DT_VCENTER | DT_SINGLELINE);

        // Action Rows
        const wchar_t* icons[] = { L"🔒", L"🌙", L"↻", L"⏻" };
        const wchar_t* labels[] = { L"Lock Session", L"Sleep", L"Restart", L"Shut Down" };

        int itemY = ScaleDpi(34);
        int itemH = ScaleDpi(34);
        int padX = ScaleDpi(10);

        SelectObject(memDC, g_hFontBtn);

        for (int i = 0; i < 4; i++) {
            RECT rcItem = { padX, itemY + (i * itemH), rc.right - padX, itemY + ((i + 1) * itemH) };

            if (g_hoveredAction == i) {
                HBRUSH hovBrush = CreateSolidBrush(i == 3 ? RGB(65, 25, 25) : RGB(28, 30, 36));
                SelectObject(memDC, hovBrush);
                SelectObject(memDC, GetStockObject(NULL_PEN));
                RoundRect(memDC, rcItem.left, rcItem.top + ScaleDpi(2), rcItem.right, rcItem.bottom - ScaleDpi(2), ScaleDpi(8), ScaleDpi(8));
                DeleteObject(hovBrush);
            }

            RECT rcIco = { rcItem.left + ScaleDpi(8), rcItem.top, rcItem.left + ScaleDpi(32), rcItem.bottom };
            RECT rcLbl = { rcItem.left + ScaleDpi(34), rcItem.top, rcItem.right - ScaleDpi(8), rcItem.bottom };

            SetTextColor(memDC, i == 3 ? RGB(255, 110, 110) : RGB(235, 240, 245));
            DrawTextW(memDC, icons[i], -1, &rcIco, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
            DrawTextW(memDC, labels[i], -1, &rcLbl, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
        }

        BitBlt(hdc, 0, 0, rc.right, rc.bottom, memDC, 0, 0, SRCCOPY);
        SelectObject(memDC, oldBmp);
        DeleteObject(memBmp);
        DeleteDC(memDC);

        EndPaint(hWnd, &ps);
        return 0;
    }

    case WM_ERASEBKGND:
        return 1;
    }
    return DefWindowProcW(hWnd, uMsg, wParam, lParam);
}

LRESULT CALLBACK BtnWndProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {
    switch (uMsg) {
    case WM_DISPLAYCHANGE:
        LoadSettings();
        RepositionBarButton(hWnd);
        return 0;

    case WM_LBUTTONUP:
        if (IsWindowVisible(g_hWndFlyout)) {
            AnimateWindow(g_hWndFlyout, 100, AW_BLEND | AW_HIDE);
        } else {
            RepositionAndShowFlyout();
        }
        return 0;

    case WM_SETCURSOR:
        SetCursor(LoadCursor(NULL, IDC_HAND));
        return TRUE;

    case WM_TIMER:
        if (wParam == 1001) {
            SetWindowPos(hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
        }
        return 0;

    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hWnd, &ps);

        RECT rc;
        GetClientRect(hWnd, &rc);

        HDC memDC = CreateCompatibleDC(hdc);
        HBITMAP memBmp = CreateCompatibleBitmap(hdc, rc.right, rc.bottom);
        HGDIOBJ oldBmp = SelectObject(memDC, memBmp);

        // 100% transparent color-key fill
        HBRUSH blackBrush = CreateSolidBrush(RGB(0, 0, 0));
        FillRect(memDC, &rc, blackBrush);
        DeleteObject(blackBrush);

        SetBkMode(memDC, TRANSPARENT);
        SetTextColor(memDC, g_settings.textColor);

        HGDIOBJ oldFont = SelectObject(memDC, g_hFontBar);
        DrawTextW(memDC, L"⏻", -1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);

        SelectObject(memDC, oldFont);
        BitBlt(hdc, 0, 0, rc.right, rc.bottom, memDC, 0, 0, SRCCOPY);

        SelectObject(memDC, oldBmp);
        DeleteObject(memBmp);
        DeleteDC(memDC);

        EndPaint(hWnd, &ps);
        return 0;
    }

    case WM_ERASEBKGND:
        return 1;

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProcW(hWnd, uMsg, wParam, lParam);
}

DWORD WINAPI PowerThread(LPVOID) {
    WNDCLASSEXW wc = { sizeof(wc) };
    wc.lpfnWndProc = BtnWndProc;
    wc.hInstance = GetModuleHandle(NULL);
    wc.lpszClassName = L"WindhawkTopBarPowerBtn";
    RegisterClassExW(&wc);

    WNDCLASSEXW wcf = { sizeof(wcf) };
    wcf.lpfnWndProc = FlyoutWndProc;
    wcf.hInstance = wc.hInstance;
    wcf.lpszClassName = L"WindhawkTopBarPowerFlyout";
    RegisterClassExW(&wcf);

    g_hWndBtn = CreateWindowExW(
        WS_EX_LAYERED | WS_EX_TOPMOST | WS_EX_NOACTIVATE,
        wc.lpszClassName, L"",
        WS_POPUP,
        0, 0, ScaleDpi(28), ScaleDpi(24),
        NULL, NULL, wc.hInstance, NULL
    );

    g_hWndFlyout = CreateWindowExW(
        WS_EX_TOPMOST | WS_EX_TOOLWINDOW,
        wcf.lpszClassName, L"",
        WS_POPUP,
        0, 0, ScaleDpi(190), ScaleDpi(184),
        NULL, NULL, wc.hInstance, NULL
    );

    if (g_hWndBtn) {
        SetLayeredWindowAttributes(g_hWndBtn, RGB(0, 0, 0), 0, LWA_COLORKEY);
        RepositionBarButton(g_hWndBtn);
        g_timerZOrder = SetTimer(g_hWndBtn, 1001, 300, NULL);

        MSG msg;
        while (GetMessageW(&msg, NULL, 0, 0)) {
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
    }
    return 0;
}

BOOL Wh_ModInit() {
    g_bRunning = TRUE;
    LoadSettings();
    g_hThread = CreateThread(NULL, 0, PowerThread, NULL, 0, &g_threadId);
    return TRUE;
}

void Wh_ModUninit() {
    g_bRunning = FALSE;
    if (g_hWndFlyout) {
        DestroyWindow(g_hWndFlyout);
        g_hWndFlyout = NULL;
    }
    if (g_hWndBtn) {
        KillTimer(g_hWndBtn, g_timerZOrder);
        DestroyWindow(g_hWndBtn);
        g_hWndBtn = NULL;
    }

    if (g_threadId) {
        PostThreadMessageW(g_threadId, WM_QUIT, 0, 0);
    }

    if (g_hThread) {
        WaitForSingleObject(g_hThread, 1000);
        CloseHandle(g_hThread);
        g_hThread = NULL;
    }

    if (g_hFontBar)   { DeleteObject(g_hFontBar); g_hFontBar = NULL; }
    if (g_hFontTitle) { DeleteObject(g_hFontTitle); g_hFontTitle = NULL; }
    if (g_hFontBtn)   { DeleteObject(g_hFontBtn); g_hFontBtn = NULL; }
}

void Wh_ModSettingsChanged() {
    LoadSettings();
    if (g_hWndBtn) {
        RepositionBarButton(g_hWndBtn);
        InvalidateRect(g_hWndBtn, NULL, TRUE);
    }
}
