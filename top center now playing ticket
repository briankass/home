} g_settings;

HWND g_hWndMedia = NULL;
HANDLE g_hMediaThread = NULL;
DWORD g_mediaThreadId = 0;

HFONT g_hFont = NULL;
HFONT g_hSymbolFont = NULL;

UINT_PTR g_timerZOrder = 0;
UINT_PTR g_timerMediaPoll = 0;
UINT_PTR g_timerScroll = 0;

volatile BOOL g_bRunning = TRUE;
WCHAR g_trackText[256] = L"";
WCHAR g_trackTitle[128] = L"";
WCHAR g_trackArtist[128] = L"";

BOOL g_isPlaying = FALSE;
BOOL g_isMuted = FALSE;
BOOL g_isFullscreen = FALSE;

