struct EnumContext {
    WCHAR* foundTrack;
    DWORD foundPriority;
};

COLORREF HexToColorRef(PCWSTR hex) {
    if (!hex || wcslen(hex) < 6) return RGB(255, 255, 255);
    int r = 0, g = 0, b = 0;
    swscanf_s(hex, L"%02x%02x%02x", &r, &g, &b);
    return RGB(r, g, b);
}

void CleanFonts() {
    if (g_hFont)       { DeleteObject(g_hFont); g_hFont = NULL; }
    if (g_hSymbolFont) { DeleteObject(g_hSymbolFont); g_hSymbolFont = NULL; }
}

void LoadSettings() {
    g_settings.fontSize = Wh_GetIntSetting(L"font_size");
    if (g_settings.fontSize <= 0) g_settings.fontSize = 13;

    PCWSTR hexColor = Wh_GetStringSetting(L"text_color");
    g_settings.textColor = HexToColorRef(hexColor);
    Wh_FreeStringSetting(hexColor);

    g_settings.xOffset = Wh_GetIntSetting(L"x_position");
    g_settings.yOffset = Wh_GetIntSetting(L"y_offset");
    if (g_settings.yOffset <= 0) g_settings.yOffset = 8;

    CleanFonts();

    HDC hdc = GetDC(NULL);
    int dpiY = GetDeviceCaps(hdc, LOGPIXELSY);
    ReleaseDC(NULL, hdc);

    auto MakeFont = [dpiY](int ptSize, int weight, DWORD quality, PCWSTR face) {
        return CreateFontW(
            -MulDiv(ptSize, dpiY, 72), 0, 0, 0, weight, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            quality, DEFAULT_PITCH | FF_DONTCARE, face
        );
    };

    g_hFont       = MakeFont(g_settings.fontSize, FW_NORMAL, ANTIALIASED_QUALITY, L"Segoe UI Variable Text");
    g_hSymbolFont = MakeFont(14,                  FW_NORMAL, CLEARTYPE_QUALITY,   L"Segoe UI Symbol");
}

BOOL CheckSystemMuteState() {
    BOOL bMuted = FALSE;
    HRESULT hr = CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
    if (FAILED(hr)) return FALSE;
    
    IMMDeviceEnumerator* pEnumerator = NULL;
    hr = CoCreateInstance(__uuidof(MMDeviceEnumerator), NULL, CLSCTX_INPROC_SERVER, __uuidof(IMMDeviceEnumerator), (void**)&pEnumerator);
    if (SUCCEEDED(hr) && pEnumerator) {
        IMMDevice* pDevice = NULL;
        hr = pEnumerator->GetDefaultAudioEndpoint(eRender, eMultimedia, &pDevice);
        if (SUCCEEDED(hr) && pDevice) {
            IAudioEndpointVolume* pEndpointVolume = NULL;
            hr = pDevice->Activate(__uuidof(IAudioEndpointVolume), CLSCTX_INPROC_SERVER, NULL, (void**)&pEndpointVolume);
            if (SUCCEEDED(hr) && pEndpointVolume) {
                pEndpointVolume->GetMute(&bMuted);
                pEndpointVolume->Release();
            }
            pDevice->Release();
        }
        pEnumerator->Release();
    }
    CoUninitialize();
    return bMuted;
}

BOOL IsFullscreenAppRunning() {
    HWND hFg = GetForegroundWindow();
    if (!hFg || hFg == g_hWndMedia) return FALSE;

    WCHAR className[64] = {0};
    GetClassNameW(hFg, className, ARRAYSIZE(className));
    if (wcscmp(className, L"Shell_TrayWnd") == 0 ||
        wcscmp(className, L"Shell_SecondaryTrayWnd") == 0 ||
        wcscmp(className, L"Progman") == 0 ||
        wcscmp(className, L"WorkerW") == 0) {
        return FALSE;
    }

    RECT rcFg;
    if (!GetWindowRect(hFg, &rcFg)) return FALSE;

    HMONITOR hMon = MonitorFromWindow(hFg, MONITOR_DEFAULTTONEAREST);
    MONITORINFO mi = { sizeof(mi) };
    if (GetMonitorInfoW(hMon, &mi)) {
        if (rcFg.left <= mi.rcMonitor.left &&
            rcFg.top <= mi.rcMonitor.top &&
            rcFg.right >= mi.rcMonitor.right &&
            rcFg.bottom >= mi.rcMonitor.bottom) {
            
            LONG style = GetWindowLongW(hFg, GWL_STYLE);
            if (style & WS_CAPTION) {
                return FALSE;
            }
            return TRUE;
        }
    }
    return FALSE;
}

void CleanMediaTitle(PCWSTR rawTitle, WCHAR* outTitle, DWORD maxLen) {
    StringCchCopyW(outTitle, maxLen, rawTitle);

    static const WCHAR* suffixes[] = {
        L" - Vivaldi",
        L" - Microsoft Edge",
        L" - Microsoft​ Edge",
        L" - Google Chrome",
        L" - Brave",
        L" - Mozilla Firefox",
        L" - Opera",
        L" - Tor Browser",
        L" - YouTube Music",
        L" - YouTube",
        L" - Spotify",
        L" - Freesound",
        L" - Instagram"
    };

    for (int i = 0; i < ARRAYSIZE(suffixes); i++) {
        size_t sLen = wcslen(suffixes[i]);
        size_t curLen = wcslen(outTitle);
        if (curLen >= sLen && _wcsicmp(outTitle + (curLen - sLen), suffixes[i]) == 0) {
            outTitle[curLen - sLen] = L'\0';
        }
    }
}

void ParseTitleAndArtist(PCWSTR full, WCHAR* outTitle, DWORD maxTitle, WCHAR* outArtist, DWORD maxArtist) {
    WCHAR cleanedFull[256];
    StringCchCopyW(cleanedFull, ARRAYSIZE(cleanedFull), full);

    const WCHAR* serviceTags[] = { L" | YouTube Music", L" | YouTube", L" | Spotify", L" | Freesound" };
    for (int i = 0; i < ARRAYSIZE(serviceTags); i++) {
        WCHAR* found = (WCHAR*)wcsstr(cleanedFull, serviceTags[i]);
        if (found) {
            *found = L'\0';
            break;
        }
    }

    static const WCHAR* delimiters[] = { L" | ", L" - ", L" · ", L" : " };
    const WCHAR* sep = NULL;
    int sepLen = 0;

    for (int i = 0; i < ARRAYSIZE(delimiters); i++) {
        sep = wcsstr(cleanedFull, delimiters[i]);
        if (sep) {
            sepLen = (int)wcslen(delimiters[i]);
            break;
        }
    }

    if (sep) {
        size_t firstPartLen = sep - cleanedFull;
        StringCchCopyNW(outTitle, maxTitle, cleanedFull, firstPartLen);
        outTitle[firstPartLen] = L'\0';

        const WCHAR* secondPart = sep + sepLen;
        while (*secondPart == L' ') secondPart++;
        StringCchCopyW(outArtist, maxArtist, secondPart);
    } else {
        StringCchCopyW(outTitle, maxTitle, cleanedFull);
        StringCchCopyW(outArtist, maxArtist, L"Media Player");
    }
}

BOOL CALLBACK EnumWindowsProc(HWND hWnd, LPARAM lParam) {
    EnumContext* ctx = (EnumContext*)lParam;
    
    WCHAR title[512] = {0};
    GetWindowTextW(hWnd, title, ARRAYSIZE(title));

    if (wcslen(title) < 3) return TRUE;

    WCHAR className[64] = {0};
    GetClassNameW(hWnd, className, ARRAYSIZE(className));

    BOOL isSpotify = (wcscmp(className, L"SpotifyMainWindow") == 0);
    BOOL isBrowser = FALSE;

    static const WCHAR* browserSuffixes[] = {
        L" - Google Chrome",
        L" - Microsoft Edge",
        L" - Microsoft​ Edge",
        L" - Brave",
        L" - Mozilla Firefox",
        L" - Vivaldi",
        L" - Opera",
        L" - Tor Browser"
    };

    for (int i = 0; i < ARRAYSIZE(browserSuffixes); i++) {
        if (wcsstr(title, browserSuffixes[i]) != NULL) {
            isBrowser = TRUE;
            break;
        }
    }

    if (isSpotify || isBrowser) {
        WCHAR cleaned[256] = {0};
        CleanMediaTitle(title, cleaned, ARRAYSIZE(cleaned));

        WCHAR* start = cleaned;
        while (*start == L' ') start++;
        size_t len = wcslen(start);
        while (len > 0 && start[len - 1] == L' ') {
            start[len - 1] = L'\0';
            len--;
        }

        if (len == 0 ||
            _wcsicmp(start, L"New Tab") == 0 ||
            _wcsicmp(start, L"Google") == 0 ||
            _wcsicmp(start, L"YouTube") == 0 ||
            _wcsicmp(start, L"Spotify") == 0 ||
            wcsstr(start, L"Listen to your favorite") != NULL ||
            wcsstr(start, L"Welcome to") != NULL ||
            wcsstr(start, L"http://") != NULL ||
            wcsstr(start, L"https://") != NULL ||
            wcsstr(start, L"www.") != NULL ||
            wcsstr(start, L".png") != NULL ||
            wcsstr(start, L".jpg") != NULL ||
            wcsstr(start, L".jpeg") != NULL ||
            wcsstr(start, L".gif") != NULL ||
            wcsstr(start, L".webp") != NULL) {
            return TRUE;
        }

        DWORD priority = (GetForegroundWindow() == hWnd) ? 2 : 1;
        if (priority > ctx->foundPriority) {
            StringCchCopyW(ctx->foundTrack, 256, start);
            ctx->foundPriority = priority;
        }
    }

    return TRUE;
}

int CalculateDynamicWidth() {
    if (wcslen(g_trackText) == 0) return 200;

    HDC hdc = GetDC(NULL);
    HGDIOBJ oldFont = SelectObject(hdc, g_hFont);
    SIZE size = {0};
    GetTextExtentPoint32W(hdc, g_trackText, (int)wcslen(g_trackText), &size);
    SelectObject(hdc, oldFont);
    ReleaseDC(NULL, hdc);

    int dynamicW = size.cx + 16 + 16 + 118 + 4;
    
    if (dynamicW < 180) return 180;
    if (dynamicW > 450) return 450;
    return dynamicW;
}

void RepositionMedia(HWND hWnd) {
    HMONITOR hMon = MonitorFromWindow(hWnd, MONITOR_DEFAULTTOPRIMARY);
    MONITORINFO mi = { sizeof(mi) };
    if (!GetMonitorInfoW(hMon, &mi)) return;

    int monWidth = mi.rcMonitor.right - mi.rcMonitor.left;
    int winWidth = CalculateDynamicWidth();
    int winHeight = 30;

    int x = mi.rcMonitor.left + (monWidth / 2) - (winWidth / 2) + g_settings.xOffset;
    int y = mi.rcMonitor.top + g_settings.yOffset;

    SetWindowPos(hWnd, HWND_TOPMOST, x, y, winWidth, winHeight, SWP_NOACTIVATE);
}

void SendMediaKey(WORD vkCode) {
    INPUT input[2] = {0};
    input[0].type = INPUT_KEYBOARD;
    input[0].ki.wVk = vkCode;
    input[1].type = INPUT_KEYBOARD;
    input[1].ki.wVk = vkCode;
    input[1].ki.dwFlags = KEYEVENTF_KEYUP;
    SendInput(2, input, sizeof(INPUT));
}

void PollMediaSession() {
    if (!g_bRunning) return;

    BOOL fullscreen = IsFullscreenAppRunning();
    if (fullscreen != g_isFullscreen) {
        g_isFullscreen = fullscreen;
        if (g_hWndMedia && g_bRunning) {
            if (g_isFullscreen) {
                ShowWindow(g_hWndMedia, SW_HIDE);
            } else if (g_isPlaying) {
                ShowWindow(g_hWndMedia, SW_SHOWNOACTIVATE);
                RedrawWindow(g_hWndMedia, NULL, NULL, RDW_ERASE | RDW_INVALIDATE | RDW_UPDATENOW);
            }
        }
    }

    if (g_isFullscreen) return;

    WCHAR foundTrack[256] = {0};
    EnumContext ctx = { foundTrack, 0 };
    EnumWindows(EnumWindowsProc, (LPARAM)&ctx);

    if (wcslen(foundTrack) == 0) {
        if (g_isPlaying) {
            g_isPlaying = FALSE;
            g_scrollOffset = 0;
            if (g_hWndMedia && g_bRunning) {
                RepositionMedia(g_hWndMedia);
                RedrawWindow(g_hWndMedia, NULL, NULL, RDW_ERASE | RDW_INVALIDATE | RDW_UPDATENOW);
            }
        }
        return;
    }

    WCHAR formatted[256] = L"";
    StringCchPrintfW(formatted, ARRAYSIZE(formatted), L"♫ %s", foundTrack);

    BOOL currentMute = CheckSystemMuteState();

    WCHAR newTitle[128];
    WCHAR newArtist[128];
    ParseTitleAndArtist(foundTrack, newTitle, ARRAYSIZE(newTitle), newArtist, ARRAYSIZE(newArtist));

    if (wcscmp(g_trackTitle, newTitle) != 0 || wcscmp(g_trackText, formatted) != 0) {
        StringCchCopyW(g_trackText, ARRAYSIZE(g_trackText), formatted);
        g_isPlaying = TRUE;
        g_isMuted = currentMute;

        StringCchCopyW(g_trackTitle, ARRAYSIZE(g_trackTitle), newTitle);
        StringCchCopyW(g_trackArtist, ARRAYSIZE(g_trackArtist), newArtist);

        g_scrollOffset = 0;
        g_scrollDirection = 1;
        g_scrollDelay = 0;

        if (g_hWndMedia && g_bRunning && !g_isFullscreen) {
            RepositionMedia(g_hWndMedia);
            ShowWindow(g_hWndMedia, SW_SHOWNOACTIVATE);
            RedrawWindow(g_hWndMedia, NULL, NULL, RDW_ERASE | RDW_INVALIDATE | RDW_UPDATENOW);
        }
    }
}

RECT GetControlBtnRect(int index, RECT rcClient) {
    int btnW = 28;
    int btnH = 26;
    int spacing = 2;
    int rightMargin = 4;
    int startX = rcClient.right - rightMargin - (4 * btnW) - (3 * spacing);
    int x = startX + ((index - 1) * (btnW + spacing));
    int y = (rcClient.bottom - btnH) / 2;
    RECT rc = { x, y, x + btnW, y + btnH };
    return rc;
}

int HitTestBar(POINT pt, RECT rcClient) {
    for (int i = 1; i <= 4; i++) {
        RECT rcBtn = GetControlBtnRect(i, rcClient);
        if (PtInRect(&rcBtn, pt)) return i;
    }
    return 0;
}

LRESULT CALLBACK MediaWndProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {
    switch (uMsg) {
    case WM_MOD_CLOSE:
        DestroyWindow(hWnd);
        return 0;

    case WM_NCHITTEST:
        return HTCLIENT;

    case WM_MOUSEMOVE: {
        if (!g_bMouseTracking) {
            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hWnd, 0 };
            TrackMouseEvent(&tme);
            g_bMouseTracking = TRUE;
        }

        POINT pt = { (short)LOWORD(lParam), (short)HIWORD(lParam) };
        RECT rcClient;
        GetClientRect(hWnd, &rcClient);

        int hit = HitTestBar(pt, rcClient);
        if (hit != g_hoverBtn) {
            g_hoverBtn = hit;
            InvalidateRect(hWnd, NULL, FALSE);
        }
        break;
    }

    case WM_MOUSELEAVE:
        g_bMouseTracking = FALSE;
        g_hoverBtn = 0;
        InvalidateRect(hWnd, NULL, FALSE);
        break;

    case WM_SETCURSOR: {
        POINT pt;
        GetCursorPos(&pt);
        ScreenToClient(hWnd, &pt);
        RECT rcClient;
        GetClientRect(hWnd, &rcClient);

        if (HitTestBar(pt, rcClient) > 0) {
            SetCursor(LoadCursor(NULL, IDC_HAND));
            return TRUE;
        }
        break;
    }

    case WM_LBUTTONUP: {
        POINT pt = { (short)LOWORD(lParam), (short)HIWORD(lParam) };
        RECT rcClient;
        GetClientRect(hWnd, &rcClient);

        int hit = HitTestBar(pt, rcClient);
        if (hit == 1) {
            SendMediaKey(VK_MEDIA_PREV_TRACK);
        } else if (hit == 2) {
            SendMediaKey(VK_MEDIA_PLAY_PAUSE);
            g_isPlaying = !g_isPlaying;
            InvalidateRect(hWnd, NULL, FALSE);
        } else if (hit == 3) {
            SendMediaKey(VK_MEDIA_NEXT_TRACK);
        } else if (hit == 4) {
            SendMediaKey(VK_VOLUME_MUTE);
            g_isMuted = !g_isMuted;
            InvalidateRect(hWnd, NULL, FALSE);
        }
        return 0;
    }

    case WM_TIMER:
        if (wParam == 2001) {
            if (!g_isFullscreen) {
                SetWindowPos(hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
            }
        } else if (wParam == 2002) {
            PollMediaSession();
        } else if (wParam == 2003) {
            if (g_isPlaying && g_trackText[0] != L'\0') {
                HDC hdc = GetDC(hWnd);
                if (hdc) {
                    HGDIOBJ oldFont = SelectObject(hdc, g_hFont);
                    SIZE size = {0};
                    GetTextExtentPoint32W(hdc, g_trackText, (int)wcslen(g_trackText), &size);
                    SelectObject(hdc, oldFont);
                    ReleaseDC(hWnd, hdc);

                    RECT rcClient;
                    GetClientRect(hWnd, &rcClient);
                    RECT rcFirstBtn = GetControlBtnRect(1, rcClient);
                    int availableWidth = (rcFirstBtn.left - 6) - 10;

                    if (size.cx > availableWidth) {
                        int maxScroll = size.cx - availableWidth;
                        
                        if (g_scrollDelay > 0) {
                            g_scrollDelay--;
                        } else {
                            g_scrollOffset += (g_scrollDirection * 2);
                            if (g_scrollOffset >= maxScroll) {
                                g_scrollOffset = maxScroll;
                                g_scrollDirection = -1;
                                g_scrollDelay = 30;
                            } else if (g_scrollOffset <= 0) {
                                g_scrollOffset = 0;
                                g_scrollDirection = 1;
                                g_scrollDelay = 30;
                            }
                            InvalidateRect(hWnd, NULL, FALSE);
                        }
                    }
                }
            }
        }
        return 0;

    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hWnd, &ps);
        RECT rc;
        GetClientRect(hWnd, &rc);

        HBRUSH blackBrush = CreateSolidBrush(RGB(0, 0, 0));
        FillRect(hdc, &rc, blackBrush);
        DeleteObject(blackBrush);

        if (g_isPlaying && g_trackText[0] != L'\0') {
            SetTextColor(hdc, g_settings.textColor);
            SetBkColor(hdc, RGB(0, 0, 0));
            HGDIOBJ oldFont = SelectObject(hdc, g_hFont);

            RECT rcFirstBtn = GetControlBtnRect(1, rc);
            RECT rcText = { 10, 0, rcFirstBtn.left - 6, rc.bottom };

            int savedDC = SaveDC(hdc);
            IntersectClipRect(hdc, rcText.left, rcText.top, rcText.right, rcText.bottom);
            
            SIZE textSize = {0};
            GetTextExtentPoint32W(hdc, g_trackText, (int)wcslen(g_trackText), &textSize);
            int textY = (rcText.bottom - rcText.top - textSize.cy) / 2;

            ExtTextOutW(hdc, rcText.left - g_scrollOffset, textY, 
                        ETO_OPAQUE | ETO_CLIPPED, &rcText, g_trackText, (UINT)wcslen(g_trackText), NULL);
            
            RestoreDC(hdc, savedDC);
            SelectObject(hdc, oldFont);
        }

        SelectObject(hdc, g_hSymbolFont);
        SetBkMode(hdc, TRANSPARENT);

        const WCHAR* playPauseIcon = g_isPlaying ? L"⏸" : L"▶";
        const WCHAR* icons[4] = { L"⏮", playPauseIcon, L"⏭", g_isMuted ? L"🔇" : L"🔊" };

        for (int i = 1; i <= 4; i++) {
            RECT rcBtn = GetControlBtnRect(i, rc);

            if (g_hoverBtn == i) {
                HBRUSH btnHov = CreateSolidBrush(RGB(45, 45, 45));
                FillRect(hdc, &rcBtn, btnHov);
                DeleteObject(btnHov);
                SetTextColor(hdc, RGB(255, 255, 255));
            } else {
                SetTextColor(hdc, RGB(200, 200, 200));
            }

            DrawTextW(hdc, icons[i - 1], -1, &rcBtn, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOCLIP);
        }

        EndPaint(hWnd, &ps);
        return 0;
    }

    case WM_ERASEBKGND:
        return 1;

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProcW(hWnd, uMsg, wParam, lParam);
}

DWORD WINAPI MediaWindowThread(LPVOID) {
    WNDCLASSEXW wc = { sizeof(wc) };
    wc.lpfnWndProc = MediaWndProc;
    wc.hInstance = GetModuleHandle(NULL);
    wc.lpszClassName = L"WindhawkTopCenterMediaBar";
    
    // Unregister class first if it exists from a previous load to prevent race conditions
    UnregisterClassW(wc.lpszClassName, wc.hInstance);
    RegisterClassExW(&wc);

    g_hWndMedia = CreateWindowExW(
        WS_EX_LAYERED | WS_EX_TOPMOST | WS_EX_NOACTIVATE,
        wc.lpszClassName, L"",
        WS_POPUP,
        0, 0, 200, 30,
        NULL, NULL, wc.hInstance, NULL
    );

    if (g_hWndMedia) {
        SetLayeredWindowAttributes(g_hWndMedia, RGB(0, 0, 0), 255, LWA_COLORKEY);

        RepositionMedia(g_hWndMedia);

        g_timerZOrder = SetTimer(g_hWndMedia, 2001, 250, NULL);
        g_timerMediaPoll = SetTimer(g_hWndMedia, 2002, 500, NULL);
        g_timerScroll = SetTimer(g_hWndMedia, 2003, 80, NULL);

        PollMediaSession();

        MSG msg;
        while (g_bRunning && GetMessageW(&msg, NULL, 0, 0)) {
            if (msg.message == WM_QUIT) break;
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
    }
    return 0;
}

BOOL Wh_ModInit() {
    g_bRunning = TRUE;
    LoadSettings();
    g_hMediaThread = CreateThread(NULL, 0, MediaWindowThread, NULL, 0, &g_mediaThreadId);
    return TRUE;
}

void Wh_ModUninit() {
    g_bRunning = FALSE;

    if (g_hWndMedia) {
        KillTimer(g_hWndMedia, g_timerZOrder);
        KillTimer(g_hWndMedia, g_timerMediaPoll);
        KillTimer(g_hWndMedia, g_timerScroll);
        PostMessageW(g_hWndMedia, WM_MOD_CLOSE, 0, 0);
    }

    g_mediaThreadId = 0;
    if (g_hMediaThread) {
        WaitForSingleObject(g_hMediaThread, 300);
        CloseHandle(g_hMediaThread);
        g_hMediaThread = NULL;
    }

    CleanFonts();
}

void Wh_ModSettingsChanged() {
    LoadSettings();
    if (g_hWndMedia) {
        RepositionMedia(g_hWndMedia);
        RedrawWindow(g_hWndMedia, NULL, NULL, RDW_ERASE | RDW_INVALIDATE | RDW_UPDATENOW);
    }
}
